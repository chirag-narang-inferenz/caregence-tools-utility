{
  "name": "generic_browser",
  "description": "Automates browser interactions to navigate websites, extract data, submit forms, and perform web-based tasks.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "payload": {
        "description": "Request model for browser tool",
        "properties": {
          "workflow_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "unique workflow id"
          },
          "execution_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "unique execution id for a workflow"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "unique user id for which the workflow is being executed"
          },
          "llm": {
            "description": "Choose LLM model and credentials",
            "oneOf": [
              {
                "properties": {
                  "model_type": {
                    "const": "Azure",
                    "default": "Azure",
                    "type": "string"
                  },
                  "azure_openai_endpoint": {
                    "description": "Endpoint URL for Azure OpenAI service.",
                    "type": "string"
                  },
                  "azure_openai_api_key": {
                    "description": "API key for Azure OpenAI service.",
                    "type": "string"
                  },
                  "azure_openai_deployment": {
                    "description": "Deployment name for Azure OpenAI service.",
                    "type": "string"
                  },
                  "azure_openai_api_version": {
                    "description": "API version for Azure OpenAI service.",
                    "type": "string"
                  }
                },
                "required": [
                  "azure_openai_endpoint",
                  "azure_openai_api_key",
                  "azure_openai_deployment",
                  "azure_openai_api_version"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "model_type": {
                    "const": "AWS",
                    "default": "AWS",
                    "type": "string"
                  },
                  "aws_access_key_id": {
                    "description": "AWS access key ID",
                    "type": "string"
                  },
                  "aws_secret_access_key": {
                    "description": "AWS secret access key",
                    "type": "string"
                  },
                  "aws_region": {
                    "description": "AWS region (e.g., us-west-2)",
                    "type": "string"
                  }
                },
                "required": [
                  "aws_access_key_id",
                  "aws_secret_access_key",
                  "aws_region"
                ],
                "type": "object"
              }
            ]
          },
          "query": {
            "description": "The natural language query to process (e.g., 'Navigate to example.com and click the login button')",
            "type": "string"
          }
        },
        "required": [
          "llm",
          "query"
        ],
        "type": "object"
      }
    },
    "required": [
      "payload"
    ],
    "type": "object"
  },
  "meta": {
    "display_name": "Web Automation",
    "icon": "IoGlobeOutline",
    "category": "Automation",
    "connection_name": [
      {
        "type": "Azure_OpenAI",
        "dependency": "Azure",
        "fields": [
          "azure_openai_endpoint",
          "azure_openai_api_key",
          "azure_openai_api_version",
          "azure_openai_deployment"
        ]
      },
      {
        "type": "AWS_Bedrock",
        "dependency": "AWS",
        "fields": [
          "aws_access_key_id",
          "aws_secret_access_key",
          "aws_region"
        ]
      }
    ],
    "dependencies": {},
    "fields": {
      "query": {
        "type": "textarea",
        "description": "Enter a natural language browser automation query. Example: 'Go to amazon.in, search for iPhone 16, open the first product and summarize reviews' or 'Navigate to example.com and click the login button'.",
        "required": true,
        "placeholder": "Example: Open gmail.com and check unread emails"
      }
    },
    "hidden_properties": [
      "execution_id",
      "workflow_id",
      "user_id"
    ],
    "fastmcp": {
      "tags": []
    }
  }
}