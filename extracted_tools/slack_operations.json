{
  "name": "slack_operations",
  "description": "Register Slack-related tools with the MCP framework.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "payload": {
        "description": "Root Slack MCP payload",
        "properties": {
          "slack_bot_token": {
            "description": "Slack Bot OAuth Token",
            "type": "string"
          },
          "slack_user_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Slack User OAuth Token"
          },
          "action_payload": {
            "oneOf": [
              {
                "properties": {
                  "action": {
                    "const": "Send Message",
                    "type": "string"
                  },
                  "payload": {
                    "anyOf": [
                      {
                        "oneOf": [
                          {
                            "description": "Post message to channel/thread",
                            "properties": {
                              "operations": {
                                "const": "Message Channel",
                                "type": "string"
                              },
                              "channel": {
                                "description": "Channel ID or #name",
                                "type": "string"
                              },
                              "text": {
                                "description": "Message text",
                                "type": "string"
                              },
                              "as_user": {
                                "default": true,
                                "description": "Post as user",
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "operations",
                              "channel",
                              "text"
                            ],
                            "type": "object"
                          },
                          {
                            "description": "Send DM to user",
                            "properties": {
                              "operations": {
                                "const": "Message User",
                                "type": "string"
                              },
                              "user_id": {
                                "description": "User ID (U...)",
                                "type": "string"
                              },
                              "text": {
                                "description": "Message text",
                                "type": "string"
                              },
                              "use_user_token": {
                                "default": true,
                                "description": "Use user token for DM",
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "operations",
                              "user_id",
                              "text"
                            ],
                            "type": "object"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Payload for sending message in slack"
                  }
                },
                "required": [
                  "action"
                ],
                "type": "object"
              },
              {
                "description": "Get channel history",
                "properties": {
                  "action": {
                    "const": "Get Message",
                    "type": "string"
                  },
                  "channel": {
                    "default": null,
                    "description": "Channel ID or name",
                    "type": "string"
                  },
                  "limit": {
                    "default": 10,
                    "description": "Number of messages",
                    "type": "integer"
                  }
                },
                "required": [
                  "action"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "slack_bot_token",
          "action_payload"
        ],
        "type": "object"
      }
    },
    "required": [
      "payload"
    ],
    "type": "object"
  },
  "meta": {
    "display_name": "Slack Operations",
    "icon": "PiSlackLogo",
    "category": "Communication",
    "connection_name": [
      {
        "type": "Slack",
        "dependency": "",
        "fields": [
          "slack_bot_token",
          "slack_user_token"
        ]
      }
    ],
    "dependencies": [
      {
        "on_change": [
          "operations"
        ],
        "on_value": "channel",
        "action": "get_channel_list"
      },
      {
        "on_change": [
          "operations"
        ],
        "on_value": "user_id",
        "action": "get_user_list"
      },
      {
        "on_change": [
          "action"
        ],
        "on_value": "channel",
        "action": "get_channel_list"
      }
    ],
    "fields": {
      "text": {
        "type": "textarea",
        "description": "Enter the message content to send"
      }
    },
    "hidden properties": [
      "session_id",
      "workflow_id",
      "user_id"
    ],
    "fastmcp": {
      "tags": []
    }
  }
}