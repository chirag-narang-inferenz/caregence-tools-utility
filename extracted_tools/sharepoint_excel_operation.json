{
  "name": "sharepoint_excel_operation",
  "description": "Read and update SharePoint excel files using simple business instructions. Supports viewing worksheet data, generating structured outputs, and applying spreadsheet updates without manual excel processing.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "payload": {
        "description": "Discriminated union for SharePoint read vs update operations",
        "oneOf": [
          {
            "description": "Request model for reading a file from SharePoint.",
            "properties": {
              "operations": {
                "const": "Read",
                "default": "Read",
                "description": "Operation to perform on the SharePoint Excel file",
                "type": "string"
              },
              "sharepoint_file_link": {
                "description": "Link to the SharePoint file",
                "type": "string"
              },
              "sheet_name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Optional sheet name for Excel files"
              }
            },
            "required": [
              "sharepoint_file_link"
            ],
            "type": "object"
          },
          {
            "description": "Request model for updating a file in SharePoint.",
            "properties": {
              "operations": {
                "const": "Update",
                "default": "Update",
                "description": "Operation to perform on the SharePoint Excel file",
                "type": "string"
              },
              "sharepoint_file_link": {
                "description": "Link to the SharePoint file",
                "type": "string"
              },
              "query": {
                "description": "Query to update the file content",
                "type": "string"
              },
              "sheet_name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Optional sheet name for Excel files"
              },
              "azure_openai_endpoint": {
                "description": "Azure OpenAI endpoint URL",
                "type": "string"
              },
              "azure_openai_api_key": {
                "description": "Azure OpenAI API key",
                "format": "password",
                "type": "string",
                "writeOnly": true
              },
              "azure_openai_deployment": {
                "description": "Azure OpenAI deployment name to use",
                "type": "string"
              },
              "azure_openai_version": {
                "description": "Azure OpenAI API version to use",
                "type": "string"
              }
            },
            "required": [
              "sharepoint_file_link",
              "query",
              "azure_openai_endpoint",
              "azure_openai_api_key",
              "azure_openai_deployment",
              "azure_openai_version"
            ],
            "type": "object"
          }
        ]
      }
    },
    "required": [
      "payload"
    ],
    "type": "object"
  },
  "meta": {
    "display_name": "SharePoint",
    "icon": "LuFileSpreadsheet",
    "category": "MCP",
    "connection_name": [
      {
        "type": "Sharepoint",
        "dependency": "",
        "fields": [
          "sharepoint_client_id",
          "sharepoint_client_secret",
          "sharepoint_tenant_id"
        ]
      },
      {
        "type": "Azure_OpenAI",
        "dependency": "Update",
        "fields": [
          "azure_openai_version",
          "azure_openai_api_key",
          "azure_openai_endpoint",
          "azure_openai_deployment"
        ]
      }
    ],
    "dependencies": {},
    "fields": {
      "sharepoint_file_link": {
        "type": "textarea",
        "description": "Link to the SharePoint file"
      },
      "query": {
        "type": "textarea",
        "description": "Query to update the file content, only required for update operations"
      }
    },
    "hidden_properties": [
      "workflow_id",
      "execution_id",
      "user_id"
    ],
    "fastmcp": {
      "tags": []
    }
  }
}